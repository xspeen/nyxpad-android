<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_new_note"
        android:shortcutDisabledMessage="@string/shortcut_new_note_disabled"
        android:shortcutId="new_note"
        android:shortcutLongLabel="@string/shortcut_new_note_long"
        android:shortcutShortLabel="@string/shortcut_new_note_short">
        <intent
            android:action="com.nyxpad.app.action.NEW_NOTE"
            android:targetClass="com.nyxpad.app.MainActivity"
            android:targetPackage="com.nyxpad.app" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_scan"
        android:shortcutDisabledMessage="@string/shortcut_scan_disabled"
        android:shortcutId="scan_qr"
        android:shortcutLongLabel="@string/shortcut_scan_long"
        android:shortcutShortLabel="@string/shortcut_scan_short">
        <intent
            android:action="com.nyxpad.app.action.SCAN_QR"
            android:targetClass="com.nyxpad.app.MainActivity"
            android:targetPackage="com.nyxpad.app" />
    </shortcut>
</shortcuts>
